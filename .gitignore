# Captured output from the backend verification suites (npm run check:*).
# These are run logs, not source — regenerate them instead of committing them.
# Scratch notes at the repository root.
#
# Every one of these is a working file from an agent session — be-*.txt,
# sync-all.txt, tt-scan.txt and a dozen more had accumulated untracked.
# No .txt has ever been tracked at the root, so the whole level is
# ignored rather than adding a line per family as the next one appears.
/*.txt

# Same reason: captured output from the web build and the mobile lint/check
# runs. Written by whoever last ran them, regenerated by running them again.
build-log.txt
eslint-log.txt
mobile-check-log.txt

# `nul` is a reserved device name on Windows; a stray `> nul` redirect creates
# an empty file that git will happily track and no Windows tool can delete.
nul
**/nul

# Template backups taken by scripts/repair-report-templates.js.
# School documents — not ours to commit.
OfflineSchoolApp/backend/backups/

# Local editor settings.
.vscode/

# Deployment secrets — never committed. The server's environment file
# (OfflineSchoolApp/deploy/backend.env, from backend.env.example), any other
# .env, Android signing keys and certificates, and database backups.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
OfflineSchoolApp/deploy/**/*.env
!OfflineSchoolApp/deploy/**/*.env.example
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
*.mobileprovision
OfflineSchoolApp/deploy/backups/
*.archive.gz
