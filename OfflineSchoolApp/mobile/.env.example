# ─────────────────────────────────────────────────────────────────────────────
# Mobile app environment
#
# Copy to `.env` for local use. `.env` is git-ignored; this file is committed
# as documentation, so never put a real secret in it.
#
# Expo inlines every EXPO_PUBLIC_* variable into the JS bundle at build time.
# That means the value is VISIBLE to anyone who unpacks the app — it is fine
# for a public API base URL, and must never hold a key or password.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the backend, including the /api suffix.
#
#   Required for release builds — src/services/api.js throws at startup without
#   it, so a build that cannot reach a server fails loudly instead of shipping.
#
#   Optional in development: if unset, the app falls back to the LAN address in
#   src/services/api.js (a phone needs the dev machine's LAN IP, not localhost).
EXPO_PUBLIC_API_URL="https://api.example.com/api"
