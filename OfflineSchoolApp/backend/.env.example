PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority

# ── Tokens ───────────────────────────────────────────────────────────────────
#
# These are the names the code actually reads. This file previously listed
# JWT_ACCESS_SECRET / JWT_ACCESS_EXPIRES, which nothing reads — a deployment
# copied from it started with a signing secret the app could not see, and fell
# back to whatever default was in place.
JWT_SECRET=change-this
JWT_REFRESH_SECRET=change-this
# Access tokens last this long. Accounts still on a temporary password get 15
# minutes regardless, until they choose one.
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES=90d

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Shown in emails and on printed documents when a school record has no name.
SCHOOL_NAME=Your School
# Where a welcome email tells somebody to go and sign in. Omit and the email
# simply does not include a link.
APP_LOGIN_URL=https://school.example.com/login

# ═════════════════════════════════════════════════════════════════════════════
# EMAIL — Brevo Transactional Email API
#
# Staff credentials, admin-issued password resets, fee reminders, gate scans
# and absence notices all leave through this. Nothing is delivered until the
# Brevo block below is filled in, and `npm run mail:verify` will say which
# provider is in force and whether the credential is accepted — without
# printing it and without sending anything.
#
# Nothing here is required to RUN the app. A school takes a register and
# records fees with no mail provider at all: every notification is still
# recorded and still shown in the parent portal, and the stored row says why
# it was not delivered. Email is a side effect, never a dependency.
#
# ── The sending domain ──────────────────────────────────────────────────────
#
# offlineschool.vgrp.org is authenticated in Brevo (SPF/DKIM), which is done
# in the Brevo panel and in DNS — not by this application. The sender below
# must be an address on an authenticated domain; Brevo refuses anything else,
# and a receiving server is entitled to treat an unverified sender as forged.
# ═════════════════════════════════════════════════════════════════════════════

# The v3 API key: Brevo panel → SMTP & API → API keys → Generate a new key.
# It begins xkeysib- and is shown once. Backend only — it must never appear in
# any variable prefixed EXPO_PUBLIC_, VITE_ or REACT_APP_, because every one of
# those is compiled into a client bundle that anyone can unpack.
BREVO_API_KEY=

# The From address, and the name a parent sees in front of it. The address is
# required; the name is optional and mail sends without it — a parent just sees
# a bare address. It is NOT treated as required, deliberately: it was once, and
# an unset display name silently disabled every email the school sent.
BREVO_SENDER_EMAIL=no-reply@offlineschool.vgrp.org
BREVO_SENDER_NAME=OfflineSchoolApp

# Where a reply goes. no-reply@ is not read by anybody, so a parent answering
# a fee reminder must land somewhere a human looks.
BREVO_REPLY_TO=support@vgrp.org

# ── Brevo templates ─────────────────────────────────────────────────────────
#
# Optional, and unset is a working state: with no id, the app sends the HTML
# it renders itself, exactly as before. Set an id and Brevo renders that
# template from the params instead, which keeps the wording out of the
# codebase and lets a head teacher change it without a deploy.
#
# The ids are per Brevo account. Create the template in Brevo → Campaigns →
# Templates, and the id is the number in its URL. There are no defaults to
# copy: an id from another account will send the wrong email or none.
#
# The startup log lists which of these are still unset.
BREVO_TEMPLATE_VERIFY_EMAIL=
BREVO_TEMPLATE_PASSWORD_RESET=
BREVO_TEMPLATE_WELCOME=
BREVO_TEMPLATE_FEE_RECEIPT=
BREVO_TEMPLATE_FEE_REMINDER=
BREVO_TEMPLATE_ATTENDANCE=
BREVO_TEMPLATE_RESULT_PUBLISHED=

# ── EMAIL_FROM (legacy, optional) ───────────────────────────────────────────
#
# Overrides BREVO_SENDER_EMAIL if set. Kept so a deployment that already had
# it keeps working; new deployments should use BREVO_SENDER_EMAIL and leave
# this empty.
EMAIL_FROM=

# ── Fallback: Brevo over SMTP ───────────────────────────────────────────────
#
# The same Brevo account by a different route, used only when BREVO_API_KEY is
# absent. It exists for a network that permits 587 and not 443. BREVO_SMTP_USER
# is the SMTP login from the panel (something like 8a1b2c001@smtp-brevo.com),
# NOT the account's login email, and BREVO_SMTP_KEY is the SMTP key, not the
# API key.
#   Brevo panel → SMTP & API → SMTP
# BREVO_SMTP_USER=
# BREVO_SMTP_KEY=

# ── Fallback: any other SMTP server ─────────────────────────────────────────
#
# For a self-hosted relay, or a local mail catcher in development. SMTP_HOST
# has no default: it used to fall back to smtp.mailtrap.io, which meant a
# half-configured deployment authenticated against a third party's server and
# failed with a message about credentials rather than about configuration.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ── Retired: Gmail and SendGrid ─────────────────────────────────────────────
#
# GMAIL_USER, GMAIL_APP_PASSWORD and SENDGRID_API_KEY are read by NOTHING.
# Both providers were removed from src/services/email.transport.js when this
# app moved to Brevo, so leaving them in an environment does not send mail —
# it just looks as though it might. Delete them.
#
# The startup log warns if either is still present.
# ── Media signatures ─────────────────────────────────────────────────────────
# Message attachments under uploads/messages are signed at read time by the
# Message model (src/utils/mediaSignature.js). Unset (the default) runs the
# gate in observe mode: unsigned access is logged, nothing is blocked. Set to
# 1 once clients' caches have refreshed past one signature lifetime — URLs
# already cached offline were received unsigned. Photos under uploads/photos
# are deliberately not signed: they are content-addressed, and the ID-card /
# report-card flows render them from the offline cache, where an expiring
# signature is harmful. Note for Docker deployments: nginx must proxy /uploads
# to the backend for the gate to be consulted at all.
REQUIRE_MEDIA_SIGNATURE=

# ── Error reporting ──────────────────────────────────────────────────────────
# Unset (the default) disables the SDK entirely: no network, no queue, no cost.
#
# Worth turning on before a real deployment. This system is designed to fail
# quietly — the mobile outbox absorbs a failed write, the desktop answers reads
# from its own database when the server is unreachable, and a stat that cannot
# be fetched renders as a zero. All correct behaviour for a school with no
# connection, and all of it means a genuine fault reaches nobody.
#
# src/instrument.js strips request bodies, query strings, cookies and the
# Authorization header before anything is sent. sendDefaultPii stays off. This
# database holds children's names, photographs and guardians' phone numbers.
SENTRY_DSN=
# Optional. 0 (the default) means no performance tracing at all — a school on a
# metered connection should not spend it on telemetry nobody asked for.
SENTRY_TRACES_SAMPLE_RATE=
# Optional. Stamps events with a build so a regression can be traced to a deploy.
SENTRY_RELEASE=
