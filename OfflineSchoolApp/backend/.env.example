PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority

# ── Tokens ───────────────────────────────────────────────────────────────────
#
# These are the names the code actually reads. This file previously listed
# JWT_ACCESS_SECRET / JWT_ACCESS_EXPIRES, which nothing reads — a deployment
# copied from it started with a signing secret the app could not see, and fell
# back to whatever default was in place.
JWT_SECRET=change-this
JWT_REFRESH_SECRET=change-this
# Access tokens last this long. Accounts still on a temporary password get 15
# minutes regardless, until they choose one.
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES=90d

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Shown in emails and on printed documents when a school record has no name.
SCHOOL_NAME=Your School
# Where a welcome email tells somebody to go and sign in. Omit and the email
# simply does not include a link.
APP_LOGIN_URL=https://school.example.com/login

# ═════════════════════════════════════════════════════════════════════════════
# EMAIL
#
# Staff credentials, password resets and fee reminders all go out through this.
# Nothing is delivered until ONE of the four blocks below is filled in, and
# `npm run mail:verify` will tell you which one is in force and whether the
# credential is accepted — without printing it, and without sending anything.
#
# Only one block is used. If more than one is filled in, the FIRST of these
# wins: SendGrid, then Brevo, then Gmail, then a generic SMTP host. That order
# is deliberate — moving off Gmail is lines added here, and a half-finished edit
# that leaves both present should land on the provider you are moving TO.
# ═════════════════════════════════════════════════════════════════════════════

# The address mail is sent FROM. Required for every provider except Gmail
# (which can only ever send as the account that authenticated).
#
# It must be an address you have VERIFIED inside the provider's account.
# SendGrid and Brevo refuse to send from anything else, and a receiving server
# is entitled to treat an unverified sender as forged.
EMAIL_FROM=

# ── Option 1: Brevo — recommended for bulk sending ───────────────────────────
#
# 300 messages a day on the free tier, against SendGrid's 100, and fee reminders
# for a school of any size are bulk mail. BREVO_SMTP_USER is the SMTP login from
# the panel (it looks like 8a1b2c001@smtp-brevo.com) and NOT your account email;
# BREVO_SMTP_KEY is the SMTP key, not an API key.
#   Settings → SMTP & API → SMTP
# BREVO_SMTP_USER=
# BREVO_SMTP_KEY=

# ── Option 2: SendGrid ───────────────────────────────────────────────────────
#
# The SMTP username is the literal string "apikey" for every account — the code
# supplies it, so only the key goes here.
#   Settings → API Keys → Create API Key (Mail Send permission is enough)
# SENDGRID_API_KEY=

# ── Option 3: Gmail — fine for testing, not for a school ─────────────────────
#
# Caps at roughly 500 messages a day and will get spam-filtered sending arrears
# notices to hundreds of families. It also needs 2-Step Verification switched ON
# for the account: turning 2SV off silently invalidates every app password it
# ever issued, and the resulting 535 error is worded exactly like a wrong
# password. Generate at myaccount.google.com/apppasswords — if that page will
# not load, 2SV is off.
#
# Paste the app password as Google shows it. The spaces are stripped for you.
# GMAIL_USER=
# GMAIL_APP_PASSWORD=

# ── Option 4: any other SMTP server ──────────────────────────────────────────
#
# SMTP_HOST has no default. It used to fall back to smtp.mailtrap.io, which
# meant a half-configured deployment authenticated against a third party and
# failed with a message about credentials rather than about configuration.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ── Media signatures ─────────────────────────────────────────────────────────
# Message attachments under uploads/messages are signed at read time by the
# Message model (src/utils/mediaSignature.js). Unset (the default) runs the
# gate in observe mode: unsigned access is logged, nothing is blocked. Set to
# 1 once clients' caches have refreshed past one signature lifetime — URLs
# already cached offline were received unsigned. Photos under uploads/photos
# are deliberately not signed: they are content-addressed, and the ID-card /
# report-card flows render them from the offline cache, where an expiring
# signature is harmful. Note for Docker deployments: nginx must proxy /uploads
# to the backend for the gate to be consulted at all.
REQUIRE_MEDIA_SIGNATURE=
