# deploy/backup/backup.env.example — configuration for mongo-backup.sh and
# mongo-restore-staging.sh.
#
# Install on the VM as /etc/offlineschool/backup.env:
#   sudo install -m 600 -o offlineschool-backup -g offlineschool-backup backup.env.example /etc/offlineschool/backup.env
# then fill it in. Never commit the real file.

# A READ-ONLY Atlas database user (role: backup, or read on this database),
# not the application's user. The SRV string from Atlas → Connect → Drivers.
BACKUP_MONGODB_URI=mongodb+srv://REPLACE_ME_BACKUP_USER:REPLACE_ME_PASSWORD@REPLACE_ME_CLUSTER.mongodb.net/REPLACE_ME_DATABASE

# Where archives go: an rclone remote and path, configured with `rclone config`
# (its credentials live in rclone's own config file, ~/.config/rclone/rclone.conf,
# mode 600). Cloudflare R2 and Backblaze B2 are both supported by rclone.
#   r2:offlineschool-backups/atlas      b2:offlineschool-backups/atlas
# Use an access key scoped to this one bucket, with no delete-bucket rights.
RCLONE_DEST=REPLACE_ME_REMOTE:REPLACE_ME_BUCKET/atlas

# Remote archives older than this are deleted after a successful upload. At least 7.
RETENTION_DAYS=30

# Optional.
BACKUP_WORK_DIR=/var/backups/offlineschool
KEEP_LOCAL=0
# A dead-man's-switch URL (e.g. https://hc-ping.com/<uuid>); pinged on start,
# success, and /fail. Alerts you when a night's backup does not happen.
HEALTHCHECK_URL=

# The rclone config both backup jobs read. The database job runs as the
# backup user and the uploads job as root, so name the file explicitly:
RCLONE_CONFIG=/home/offlineschool-backup/.config/rclone/rclone.conf

# ── The uploads volume (uploads-backup.sh) ──────────────────────────────────
# The Docker volume holding photographs and documents. Left empty, the one
# volume whose name ends in uploads_data is used (Compose prefixes the project).
UPLOADS_VOLUME=
# A second dead-man's-switch URL for the uploads job.
UPLOADS_HEALTHCHECK_URL=

# ── Restore drills only (mongo-restore-staging.sh) ───────────────────────────
# The ISOLATED staging cluster or database to restore into. Never production.
RESTORE_TARGET_URI=mongodb+srv://REPLACE_ME_STAGING_USER:REPLACE_ME_PASSWORD@REPLACE_ME_STAGING_CLUSTER.mongodb.net/
# The database name inside the backup, and the name to restore it as on staging.
RESTORE_SOURCE_DB=REPLACE_ME_DATABASE
RESTORE_TARGET_DB=restore_drill
