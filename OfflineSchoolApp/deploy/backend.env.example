# deploy/backend.env.example — the production backend's environment.
#
# Copy to deploy/backend.env ON THE SERVER, fill in, and protect it:
#
#   cp deploy/backend.env.example deploy/backend.env
#   chmod 600 deploy/backend.env
#
# deploy/backend.env is gitignored. Never commit it, paste it into a ticket or
# chat, or bake it into an image: docker-compose.yml passes it to the backend
# container at run time (env_file). Every REPLACE_ME below must be replaced.
# Plain KEY=value lines, no quotes, no `export`.
#
# NODE_ENV, PORT and TZ are set by docker-compose.yml and override this file.
# The full reference for every variable is backend/.env.example and docs/17.

# ── Required (the backend refuses to start without these) ────────────────────

# MongoDB Atlas. The SRV string from Atlas → Connect → Drivers, with a
# database user that has readWrite on this database only (not Atlas admin).
# Atlas → Network Access must allow the VM's public IP.
MONGODB_URI=mongodb+srv://REPLACE_ME_USER:REPLACE_ME_PASSWORD@REPLACE_ME_CLUSTER.mongodb.net/REPLACE_ME_DATABASE?retryWrites=true&w=majority

# 32+ random characters each, different from each other:
#   openssl rand -base64 48
JWT_SECRET=REPLACE_ME
JWT_REFRESH_SECRET=REPLACE_ME
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES=90d

# The CORS allow-list: every browser origin that calls this API, comma-
# separated, scheme and host exactly, no trailing slash. The Cloudflare Pages
# site (and its custom domain, if any). Not "*", not "null".
ALLOWED_ORIGINS=https://REPLACE_ME_WEB_DOMAIN

# LEAVE UNSET IN PRODUCTION. ALLOWED_ORIGIN_PATTERNS admits whole families of
# origins by regex (a dev backend uses it for every Cloudflare Pages preview,
# docs/17). Production serves the console's exact origins above and nothing
# else; preview builds must never reach live school data.
# ALLOWED_ORIGIN_PATTERNS=

# ── Links the backend writes into emails and documents ───────────────────────

# The public API origin (this server), used for absolute links in generated
# documents, e.g. https://api.example.cm
BASE_URL=https://REPLACE_ME_API_DOMAIN
# The web console's login page, used in emails.
APP_LOGIN_URL=https://REPLACE_ME_WEB_DOMAIN/login
SCHOOL_NAME=REPLACE_ME

# ── Email (optional — without it nothing is sent, everything else works) ─────

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_REPLY_TO=
# Gmail failover: both or neither.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional Brevo template ids, one per message. Unset, the app sends its own
# HTML for that message (docs/20).
BREVO_TEMPLATE_WELCOME=
BREVO_TEMPLATE_PASSWORD_RESET=
BREVO_TEMPLATE_VERIFY_EMAIL=
BREVO_TEMPLATE_FEE_RECEIPT=
BREVO_TEMPLATE_FEE_REMINDER=
BREVO_TEMPLATE_RESULT_PUBLISHED=
BREVO_TEMPLATE_ATTENDANCE=

# ── Media signatures ─────────────────────────────────────────────────────────

# 1 enforces signed /uploads/ URLs. Leave unset (observe mode) for the first
# 7 days after launch, then set 1 (docs/17 checklist).
REQUIRE_MEDIA_SIGNATURE=

# ── Error reporting (optional) ───────────────────────────────────────────────

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_RELEASE=

# ── Advanced analysis (optional; docs/38) ────────────────────────────────────

# anthropic to turn it on; unset or none = deterministic explanations only.
ADVANCED_INTELLIGENCE_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
# Unset = claude-sonnet-5-5. (ADVANCED_INTELLIGENCE_MODEL is an older name for
# the same setting; ANTHROPIC_MODEL wins when both are set.)
ANTHROPIC_MODEL=
# Per-request timeout, ms (default 20000); effort low|medium|high (default
# low); refusal fallbacks on|off (default off).
ADVANCED_INTELLIGENCE_TIMEOUT_MS=
ADVANCED_INTELLIGENCE_EFFORT=
ADVANCED_INTELLIGENCE_MODEL_FALLBACKS=
# One analysis worker's heap, MB. Budget this much free RAM per concurrent
# analysis on the VM.
ANALYSIS_WORKER_HEAP_MB=2048
ANALYSIS_CONCURRENCY=1
# A worker running longer is stopped (default 600000 = 10 minutes); the
# largest compressed report stored (default 12582912 = 12 MB).
ANALYSIS_TIMEOUT_MS=
ANALYSIS_REPORT_MAX_BYTES=
CALIBRATION_SALT=

# ── WhatsApp (optional) ──────────────────────────────────────────────────────

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Never set in production: DISABLE_LOGIN_RATE_LIMIT
