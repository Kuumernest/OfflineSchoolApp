{
  "name": "school-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "The school console as an offline-first desktop application",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/launch.js",
    "smoke": "node scripts/launch.js --smoke",
    "probe": "node scripts/probe-launch.js",
    "check": "npm run check:protocol && npm run check:tombstones && npm run check:unsent && npm run check:routes && npm run check:store && npm run check:outbox && npm run check:crash && npm run check:sync && npm run check:path && npm run check:student-writes && npm run check:score-writes && npm run check:process-rules && npm run check:results && npm run check:intel-deleted && npm run check:settings && npm run check:roster && npm run check:reliability && npm run check:initial-sync && npm run check:messages && npm run check:receipt && npm run check:read-perms && npm run check:outbox-owner && npm run check:recovery && npm run check:structure-creates",
    "check:protocol": "node scripts/check-app-protocol.js",
    "check:launch": "node scripts/check-desktop-launch.js",
    "check:tombstones": "node scripts/check-tombstones.js",
    "check:mirror-tombstones": "node scripts/check-mirror-tombstones.js",
    "check:unsent": "node scripts/check-unsent-copy.js",
    "check:store": "node scripts/check-doc-store.js",
    "check:crash": "node scripts/check-crash-seams.js",
    "check:outbox": "node scripts/check-outbox.js",
    "check:sync": "node scripts/check-sync-engine.js",
    "check:path": "node scripts/check-request-path.js",
    "check:student-writes": "node scripts/check-student-writes.js",
    "check:score-writes": "node scripts/check-score-writes.js",
    "check:process-rules": "node scripts/check-process-rules.js",
    "check:results": "node scripts/check-results.js",
    "check:intel-deleted": "node scripts/check-intelligence-deleted-exam.js",
    "check:settings": "node scripts/check-settings.js",
    "check:roster": "node scripts/check-teacher-roster.js",
    "check:reliability": "node scripts/check-sync-reliability.js",
    "check:seam": "node scripts/seam-launch.js",
    "build:web": "npm --prefix ../web run build",
    "package": "npm run build:web && electron-builder --config electron-builder.yml",
    "package:dir": "npm run build:web && electron-builder --config electron-builder.yml --dir",
    "coverage": "node scripts/coverage.js",
    "check:routes": "node scripts/check-route-shadowing.js",
    "check:initial-sync": "node scripts/check-initial-sync.js",
    "check:messages": "node scripts/check-messages.js",
    "check:receipt": "node scripts/check-provisional-receipt.js",
    "check:read-perms": "node scripts/check-read-permissions.js",
    "check:outbox-owner": "node scripts/check-outbox-ownership.js",
    "check:recovery": "node scripts/check-sync-recovery.js",
    "check:structure-creates": "node scripts/check-structure-creates.js"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "author": "My School On The Move"
}
