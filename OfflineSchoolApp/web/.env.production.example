# Production API base URL.
# The nginx reverse proxy forwards /api → backend:5000.
# For a custom domain, set this to https://yourdomain.com/api
VITE_API_URL=/api

# ── Error reporting ──────────────────────────────────────────────────────────
# Unset disables the SDK entirely. Worth setting for the desktop build above
# all: that bundle runs inside Electron in a school office, where a crash has no
# console anyone will read and no user who will file a report.
#
# src/lib/instrument.ts drops console breadcrumbs (this app logs pupil rows and
# sync payloads to the console) and strips query strings, which carry schoolId
# and studentId. Session replay is deliberately not enabled — it would record a
# screen showing children's names and marks.
VITE_SENTRY_DSN=
# 0 by default. Performance tracing is opt-in.
VITE_SENTRY_TRACES_SAMPLE_RATE=
VITE_SENTRY_RELEASE=
