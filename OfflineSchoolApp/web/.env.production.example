# Production API base URL.
# The nginx reverse proxy forwards /api → backend:5000.
# For a custom domain, set this to https://yourdomain.com/api
VITE_API_URL=/api

# ── Error reporting ──────────────────────────────────────────────────────────
# Unset disables the SDK entirely. Worth setting for the desktop build above
# all: that bundle runs inside Electron in a school office, where a crash has no
# console anyone will read and no user who will file a report.
#
# src/lib/instrument.ts drops console breadcrumbs (this app logs pupil rows and
# sync payloads to the console) and strips query strings, which carry schoolId
# and studentId. Session replay is deliberately not enabled — it would record a
# screen showing children's names and marks.
VITE_SENTRY_DSN=
# 0 by default. Performance tracing is opt-in.
VITE_SENTRY_TRACES_SAMPLE_RATE=
VITE_SENTRY_RELEASE=

# ── The phone app, for teachers and students (src/config/mobileApp.ts) ──────
# The web console is for the school office; a teacher or student who signs in
# here gets a screen pointing them to the phone app, with these links. Unset (or
# not an http(s) URL), no link is shown and the screen says to ask the office.
#
# Android: the APK the release workflow publishes (.github/workflows/release.yml).
# NOTE: the only one so far is v0.1.1, a TESTING pre-release. Replace it with a
# production release's APK — or the Play Store listing once the app is there.
VITE_ANDROID_APP_URL=https://github.com/Kuumernest/OfflineSchoolApp/releases/download/v0.1.1/MySchoolOnTheMove-0.1.1-android.apk
# iPhone: REPLACE_ME — there is no App Store listing or iOS build yet. Leave
# empty until there is; the screen then shows no iPhone link.
VITE_IOS_APP_URL=
